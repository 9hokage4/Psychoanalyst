/* ========================================
   Psychoanalyst - Global Styles (полная версия)
   ======================================== */

/* =================================================================
   ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ (комментарий, в QSS переменных нет)
   ================================================================= */
/*
   --color-primary: #3390EC;
   --color-highlight-bg: #b4d1ee;
   --color-highlight-text: #0678ea;
   --color-hover-bg: #F4F4F5;
   --color-white: #FFFFFF;
   --color-black: #000000;
   --color-bg: #F5F5F5;
   --color-text-secondary: #707579;
   --color-border: #DFE1E5;
   --color-success: #6BBF8A;
   --color-danger: #E07B7B;
*/

/* =================================================================
   ГЛОБАЛЬНЫЕ СТИЛИ КНОПОК (QPushButton)
   ================================================================= */
QPushButton {
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    icon-size: 20px;
}

QPushButton:disabled {
    background-color: #CCCCCC;
    color: #666666;
}

/* PRIMARY кнопки (синие) */
QPushButton#btn_load_file,
QPushButton#btn_settings,
QPushButton#btn_process,
QPushButton#btn_profile,
QPushButton#btn_add_level,
QPushButton#btn_add_scale,
QPushButton#btn_load_profile {
    background-color: #3390EC;  /* --color-primary */
    color: white;
}
QPushButton#btn_load_file:hover,
QPushButton#btn_settings:hover,
QPushButton#btn_process:hover,
QPushButton#btn_profile:hover,
QPushButton#btn_add_level:hover,
QPushButton#btn_add_scale:hover,
QPushButton#btn_load_profile:hover {
    background-color: #2B80D9;
}

/* SUCCESS кнопки (зелёные) */
QPushButton#btn_save_file,
QPushButton#btn_save_profile,
QPushButton#btn_save {
    background-color: #6BBF8A;  /* --color-success */
    color: white;
}
QPushButton#btn_save_file:hover,
QPushButton#btn_save_profile:hover,
QPushButton#btn_save:hover {
    background-color: #5AA878;
}

/* DANGER кнопки (красные) */
QPushButton#btn_delete,
QPushButton#btn_delete_level,
QPushButton#btn_delete_scale,
QPushButton#btn_delete_profile {
    background-color: #E07B7B;  /* --color-danger */
    color: white;
}
QPushButton#btn_delete:hover,
QPushButton#btn_delete_level:hover,
QPushButton#btn_delete_scale:hover,
QPushButton#btn_delete_profile:hover {
    background-color: #C96A6A;
}

/* SECONDARY кнопки (белые с рамкой) */
QPushButton#btn_cancel,
QPushButton#btn_close {
    background-color: #F8F9FA;
    color: #212529;
    border: 2px solid #DFE1E5;  /* --color-border */
}
QPushButton#btn_cancel:hover,
QPushButton#btn_close:hover {
    background-color: #E9ECEF;
    border-color: #ADB5BD;
}

/* =================================================================
   ГОРИЗОНТАЛЬНАЯ НАВИГАЦИОННАЯ ПАНЕЛЬ
   ================================================================= */
QWidget#nav_container {
    background-color: #FFFFFF;
    border-radius: 44px;  /* овальная форма (половина высоты 88px) */
    /* тень добавляется через QGraphicsDropShadowEffect в коде */
}

/* =================================================================
   КАСТОМНЫЕ КНОПКИ НАВИГАЦИИ (NavButton)
   ================================================================= */
NavButton {
    background-color: red !important;
    border: none;
    min-width: 112px;
    min-height: 70px;
    border-radius: 34px / 35px;  /* овальная форма под размер кнопки */
}
NavButton[checked="true"] {
    background-color: #b4d1ee;  /* --color-highlight-bg */
}
NavButton:hover {
    background-color: #F4F4F5;  /* --color-hover-bg */
}
NavButton QLabel {
    color: #000000;
    font-size: 14px;
    font-weight: 500;
}
NavButton[checked="true"] QLabel {
    color: #0678ea;  /* --color-highlight-text */
}

/* =================================================================
   ВКЛАДКИ (QTabWidget) – для диалога настроек
   ================================================================= */
QTabWidget::pane {
    border: 1px solid #DFE1E5;
    border-radius: 8px;
    background-color: white;
    top: -2px;
    padding-top: 10px;
}

QTabBar::tab {
    background-color: #F8F9FA;
    color: #666666;
    border: 1px solid #DFE1E5;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 14px 28px;
    margin-right: 4px;
    font-size: 18px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: white;
    color: #3390EC;
    border-bottom: 1px solid white;
    margin-bottom: -1px;
}

QTabBar::tab:hover:!selected {
    background-color: #E9ECEF;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* =================================================================
   ПОЛЯ ВВОДА (QLineEdit)
   ================================================================= */
QLineEdit {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #212529;
}
QLineEdit:focus {
    border-color: #3390EC;
}
QLineEdit:disabled {
    background-color: #F0F0F0;
    color: #999999;
}

/* =================================================================
   ВЫПАДАЮЩИЕ СПИСКИ (QComboBox)
   ================================================================= */
QComboBox {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #212529;
    min-width: 120px;
}
QComboBox:focus {
    border-color: #3390EC;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    border-left: 1px solid #DFE1E5;
    background-color: #F8F9FA;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QComboBox::down-arrow {
    image: url("resources/icons/chevron-down.svg");
    width: 16px;
    height: 16px;
    margin-right: 8px;
}
QComboBox:hover {
    border-color: #ADB5BD;
}
QComboBox::drop-down:hover {
    background-color: #E9ECEF;
}

/* =================================================================
   СПИНБОКСЫ (QSpinBox)
   ================================================================= */
QSpinBox {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 8px 24px 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #212529;
}
QSpinBox:focus {
    border-color: #3390EC;
}
QSpinBox:disabled {
    background-color: #F0F0F0;
    color: #999999;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 14px;
    border: none;
    background-color: transparent;
    margin: 2px 2px 0px 0px;
    padding: 0px;
    border-top-right-radius: 6px;
}
QSpinBox::up-button:hover {
    background-color: #F8F9FA;
}
QSpinBox::up-arrow {
    image: url("resources/icons/chevron-up.svg");
    width: 20px;
    height: 20px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 14px;
    border: none;
    background-color: transparent;
    margin: 0px 2px 2px 0px;
    padding: 0px;
    border-bottom-right-radius: 6px;
}
QSpinBox::down-button:hover {
    background-color: #F8F9FA;
}
QSpinBox::down-arrow {
    image: url("resources/icons/chevron-down.svg");
    width: 20px;
    height: 20px;
}

/* =================================================================
   УРОВНИ ПОКАЗАТЕЛЕЙ (вкладка "Уровни" в диалоге настроек)
   ================================================================= */
QFrame#level_frame {
    background-color: white;
    border: 1px solid #DFE1E5;
    border-radius: 8px;
    min-width: 750px;
    max-width: 900px;
    min-height: 80px;
    max-height: 80px;
}
QLabel#level_num_title {
    color: #212529;
    font-size: 14px;
    min-height: 36px;
    max-height: 36px;
    padding: 0px;
    margin: 0px;
}
QLabel#level_label {
    color: #212529;
    font-size: 14px;
    min-height: 36px;
    max-height: 36px;
    padding: 0px;
    margin: 0px;
}
QLineEdit#level_name_input {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #212529;
    min-width: 180px;
    max-width: 180px;
    min-height: 36px;
    max-height: 36px;
    margin: 0px;
}
QLineEdit#level_name_input:focus {
    border-color: #3390EC;
}
QSpinBox#level_boundary_spin {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 8px 20px 8px 10px;
    font-size: 14px;
    background-color: white;
    color: #212529;
    min-width: 70px;
    max-width: 70px;
    min-height: 36px;
    max-height: 36px;
}
QSpinBox#level_boundary_spin:focus {
    border-color: #3390EC;
}
QPushButton#btn_delete_level {
    background-color: #E07B7B;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    min-width: 100px;
    max-width: 100px;
    min-height: 36px;
    max-height: 36px;
}
QPushButton#btn_delete_level:hover {
    background-color: #C96A6A;
}
QLabel#hint_icon {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    min-width: 32px;
    min-height: 36px;
    max-width: 32px;
    max-height: 36px;
}

/* =================================================================
   ЧЕКБОКСЫ (QCheckBox)
   ================================================================= */
QCheckBox {
    color: #212529;
    font-size: 14px;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #DFE1E5;
    border-radius: 4px;
    background-color: white;
}
QCheckBox::indicator:checked {
    background-color: #3390EC;
    border-color: #3390EC;
}
QCheckBox::indicator:hover {
    border-color: #3390EC;
}

/* =================================================================
   ГРУППЫ (QGroupBox)
   ================================================================= */
QGroupBox {
    font-weight: bold;
    border: 2px solid #DFE1E5;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    color: #212529;
    font-size: 14px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #3390EC;
    font-size: 14px;
}
QGroupBox#questions_group,
QGroupBox#bounds_group {
    font-weight: bold;
    border: 2px solid #DFE1E5;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    color: #212529;
}
QGroupBox#questions_group::title,
QGroupBox#bounds_group::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #3390EC;
}

/* =================================================================
   ОБЛАСТИ ПРОКРУТКИ (QScrollArea)
   ================================================================= */
QScrollArea#levels_scroll {
    border: 2px solid #DFE1E5;
    border-radius: 8px;
    background-color: white;
    padding: 15px;
    min-width: 800px;
    max-width: 750px;
}
QScrollArea#scales_scroll {
    border: none;
    background: transparent;
}
QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background-color: #CCCCCC;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #AAAAAA;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #F0F0F0;
    height: 12px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background-color: #CCCCCC;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #AAAAAA;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* =================================================================
   МЕТКИ (QLabel)
   ================================================================= */
QLabel {
    color: #212529;
    font-size: 14px;
}
QLabel#title_label {
    font-size: 22px;
    font-weight: bold;
    color: #212529;
}
QLabel#info_label {
    color: #666666;
    font-size: 14px;
}
QLabel#hint_label {
    color: #666666;
    font-size: 14px;
    font-style: italic;
}
QLabel#weight_label {
    font-weight: bold;
    color: #212529;
    font-size: 14px;
}

/* =================================================================
   КОНТЕЙНЕРЫ (QWidget, QFrame)
   ================================================================= */
QWidget#levels_container,
QWidget#scales_container {
    background-color: transparent;
    border: none;
    padding: 0px;
}
QFrame#btn_frame {
    background-color: #F8F9FA;
    border-top: 1px solid #DFE1E5;
    padding: 15px;
}
QFrame#shared_frame {
    background-color: #F8F9FA;
    border: 2px solid #DFE1E5;
    border-radius: 8px;
    padding: 15px;
}
QFrame#table_container,
QFrame#scale_frame,
QFrame#weights_container {
    background-color: white;
    border: 1px solid #DFE1E5;
    border-radius: 8px;
}

/* =================================================================
   СПЕЦИАЛЬНЫЕ SPINBOX (основные параметры, веса)
   ================================================================= */
QSpinBox#questions_spin,
QSpinBox#answers_spin {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 15px;
    background-color: white;
    color: #212529;
}
QSpinBox#questions_spin:focus,
QSpinBox#answers_spin:focus {
    border-color: #3390EC;
}
QSpinBox#single_weight_spin {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    padding: 10px 14px;
    font-size: 15px;
    background-color: white;
    color: #212529;
}
QSpinBox#single_weight_spin:focus {
    border-color: #3390EC;
}

/* =================================================================
   ОШИБКИ (поля с ошибкой валидации)
   ================================================================= */
QLineEdit#error_input {
    border: 2px solid #E07B7B;
    background-color: #FFF5F5;
    padding: 8px 12px;
    font-size: 14px;
    min-width: 180px;
    max-width: 180px;
    min-height: 36px;
    max-height: 36px;
}
QLineEdit#error_input:focus {
    border-color: #C96A6A;
}

/* =================================================================
   СПИСКИ (QListWidget)
   ================================================================= */
QListWidget {
    border: 2px solid #DFE1E5;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    background-color: white;
    color: #212529;
    outline: none;
}
QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    border: none;
}
QListWidget::item:selected {
    background-color: #3390EC;
    color: white;
    border: none;
}
QListWidget::item:hover {
    background-color: #F4F4F5;
}

/* =================================================================
   ДИАЛОГОВЫЕ ОКНА (QMessageBox)
   ================================================================= */
QMessageBox {
    background-color: white;
}
QMessageBox QLabel {
    color: #212529;
    font-size: 14px;
    padding: 10px;
}
QMessageBox QPushButton {
    min-width: 80px;
    max-width: 100px;
    min-height: 32px;
    max-height: 32px;
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 16px;
}
QMessageBox QPushButton:hover {
    background-color: #E9ECEF;
    border-color: #ADB5BD;
}
QMessageBox QPushButton:focus {
    border-color: #3390EC;
}

/* =================================================================
   ПРОГРЕСС БАРЫ (QProgressBar)
   ================================================================= */
QProgressBar {
    border: 2px solid #DFE1E5;
    border-radius: 6px;
    background-color: #F0F0F0;
    text-align: center;
    height: 20px;
    font-size: 13px;
}
QProgressBar::chunk {
    background-color: #3390EC;
    border-radius: 4px;
}

/* =================================================================
   ТАБЛИЦЫ (QTableView, QHeaderView)
   ================================================================= */
QTableView {
    background-color: transparent;
    border: none;
    gridline-color: #DFE1E5;
    color: #212529;
    font-size: 14px;
}
QTableView::item {
    padding: 6px 10px;
    border-right: 1px solid #F0F0F0;
    border-bottom: 1px solid #F0F0F0;
}
QHeaderView::section {
    background-color: #E9ECEF;
    color: #212529;
    font: bold 14px "Arial";
    padding: 10px 14px;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QHeaderView {
    background-color: transparent;
    border: none;
}